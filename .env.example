# Gemma 4 via the Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: exact Gemma 4 model id. Empty = auto-pick (prefers fast gemma-4-26b-a4b-it, falls back to gemma-4-31b-it).
GEMMA_MODEL=
# auto | embeddinggemma | lsa
EMBEDDER=auto
# Needed only to download EmbeddingGemma (gated model on Hugging Face)
HF_TOKEN=
# Optional: raises GitHub API limits when building the collection
GITHUB_TOKEN=
# minimal = fast structured output; empty = model default thinking
GEMMA_THINKING=minimal
# Optional: live US patent results (free key at https://patentsview.org/apis/keyrequest). Without it, patent search links are shown.
PATENTSVIEW_API_KEY=
# Input-token budget per Gemma model per minute (free tier: 16000). 0 disables pacing for paid keys.
GEMMA_TPM=15000
